# Copy to .env and fill in. Used by docker-compose.yml.

# Randomly generated, shared across restarts. Required.
SESSION_SECRET=

# Host port for the web UI. Default 8082.
PORT=8082

# Set "false" when serving plain HTTP behind nginx, "true" for HTTPS.
COOKIE_SECURE=true

# Per-attachment upload limit in MB. Default 512.
MAX_UPLOAD_MB=512

# Turn on scheduling/UI for the optional AI OCR/captioning worker.
ENABLE_AI_TRANSCRIPTION=false

# Internal base URL of the ai-worker container. The default below is correct
# for the stock compose stack (same compose network, service name ai-worker,
# port 8000). Only change it if your ai-worker runs elsewhere.
AI_WORKER_URL=http://ai-worker:8000

# OCR/captioning model for the ai-worker: florence-2-base | florence-2-large | tesseract.
TRANSCRIPTION_MODEL=florence-2-base