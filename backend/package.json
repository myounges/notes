{
  "name": "notes-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal markdown notes server - backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-password": "tsx src/lib/bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.2.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.2",
    "fastify": "^5.3.2",
    "gray-matter": "^4.0.3",
    "node-cron": "^4.2.1",
    "tar-stream": "2.2.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/tar-stream": "^3.1.0",
    "@types/yauzl": "^2.10.3",
    "fastify-plugin": "^5.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
